---
import type { PortfolioContent } from "../content/types";
import ThemeControl from "./ThemeControl.astro";
import { getRelativeLocaleUrl } from "astro:i18n";
import { getLocaleConfig } from "../i18n/config";

interface Props {
  content: PortfolioContent;
}

const { content } = Astro.props;
const locale = getLocaleConfig(content.lang);
const alternateHref = getRelativeLocaleUrl(locale.alternate);
---

<header class="site-header">
  <nav class="nav-shell" aria-label={content.navLabel}>
    <a class="brand" href="#home" data-view-link>Sebastian Garay</a>

    <div class="desktop-nav">
      {
        content.nav.map((item) => (
          <a href={item.href} data-view-link>
            {item.label}
          </a>
        ))
      }
    </div>

    <div class="nav-actions">
      <ThemeControl content={content} />
      <a
        class="language-switch"
        href={`${alternateHref}#home`}
        data-language-switch
        hreflang={locale.alternate}
      >
        <span class:list={[content.lang === "en" && "active"]}>EN</span>
        <span aria-hidden="true">/</span>
        <span class:list={[content.lang === "es" && "active"]}>ES</span>
      </a>
      <a
        class="github-mark"
        href="https://github.com/SebastianGaray"
        aria-label="GitHub"
        rel="me"
      >
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path
            d="M8.7 17.7 3 12l5.7-5.7 1.4 1.4L5.8 12l4.3 4.3-1.4 1.4Zm6.6 0-1.4-1.4 4.3-4.3-4.3-4.3 1.4-1.4L21 12l-5.7 5.7Z"
          ></path>
        </svg>
      </a>
      <details class="mobile-nav">
        <summary>{content.menu}</summary>
        <div>
          {
            content.nav.map((item) => (
              <a href={item.href} data-view-link>
                {item.label}
              </a>
            ))
          }
        </div>
      </details>
    </div>
  </nav>
</header>

<script>
  const languageSwitch = document.querySelector<HTMLAnchorElement>(
    "[data-language-switch]",
  );

  languageSwitch?.addEventListener("click", () => {
    const section = window.location.hash || "#home";
    languageSwitch.href = `${languageSwitch.pathname}${section}`;
  });
</script>
