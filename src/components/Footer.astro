---
import type { PortfolioContent } from "../content/types";

interface Props {
  content: PortfolioContent;
}

const { content } = Astro.props;
---

<footer class="site-footer">
  <div class="footer-shell">
    <div>
      <a class="footer-brand" href="#home">Sebastian Garay</a>
      <small>© {new Date().getFullYear()} Sebastian Garay</small>
    </div>
    <nav aria-label={content.contact.eyebrow}>
      <a href="https://github.com/SebastianGaray" rel="me">
        {content.labels.github}
      </a>
      <a href="https://www.linkedin.com/in/sebastián-garay-b28610195/" rel="me">
        {content.labels.linkedin}
      </a>
      <a href="mailto:sebastian.garay.p@usach.cl">{content.labels.email}</a>
    </nav>
    <small>{content.labels.builtWith}</small>
  </div>
</footer>
