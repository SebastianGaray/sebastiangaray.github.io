---
import { getCollection } from "astro:content";
import type { Messages } from "../i18n";
import BaseLayout from "../layouts/BaseLayout.astro";

interface Props {
  messages: Messages;
  alternateHref: string;
}

const { messages, alternateHref } = Astro.props;
const entries = (await getCollection("openSource"))
  .filter((entry) => entry.data.language === messages.lang)
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());
---

<BaseLayout
  lang={messages.lang}
  messages={messages}
  title={messages.openSource.title}
  description={messages.openSource.description}
  alternateHref={alternateHref}
  translationKey="open-source-index"
>
  <header class="page-header">
    <h1>{messages.openSource.title}</h1>
    <p>{messages.openSource.description}</p>
  </header>
  <section class="section" aria-label={messages.openSource.title}>
    <div class="open-source-list">
      {
        entries.map((entry) => (
          <article class="open-source-item">
            <div>
              <h2>{entry.data.title}</h2>
              <ul class="tag-list" aria-label={messages.caseStudy.stack}>
                {entry.data.stack.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            </div>
            <p>{entry.data.description}</p>
            <a href={entry.data.repository}>
              {messages.openSource.repository} ↗
            </a>
          </article>
        ))
      }
    </div>
  </section>
</BaseLayout>
