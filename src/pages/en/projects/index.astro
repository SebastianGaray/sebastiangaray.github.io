---
import { getCollection } from "astro:content";
import ProjectList from "../../../components/ProjectList.astro";
import { en } from "../../../i18n/en";
import BaseLayout from "../../../layouts/BaseLayout.astro";

const projects = (await getCollection("projects"))
  .filter((entry) => entry.data.language === "en")
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());
---

<BaseLayout
  lang="en"
  messages={en}
  title={en.projects.title}
  description={en.projects.description}
  alternateHref="/es/proyectos/"
  translationKey="projects-index"
>
  <header class="page-header">
    <h1>{en.projects.title}</h1>
    <p>{en.projects.description}</p>
  </header>
  <section class="section" aria-label={en.projects.title}>
    <ProjectList projects={projects} messages={en} />
  </section>
</BaseLayout>
