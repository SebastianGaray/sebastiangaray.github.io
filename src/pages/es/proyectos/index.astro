---
import { getCollection } from "astro:content";
import ProjectList from "../../../components/ProjectList.astro";
import { es } from "../../../i18n/es";
import BaseLayout from "../../../layouts/BaseLayout.astro";

const projects = (await getCollection("projects"))
  .filter((entry) => entry.data.language === "es")
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());
---

<BaseLayout
  lang="es"
  messages={es}
  title={es.projects.title}
  description={es.projects.description}
  alternateHref="/en/projects/"
  translationKey="projects-index"
>
  <header class="page-header">
    <h1>{es.projects.title}</h1>
    <p>{es.projects.description}</p>
  </header>
  <section class="section" aria-label={es.projects.title}>
    <ProjectList projects={projects} messages={es} />
  </section>
</BaseLayout>
