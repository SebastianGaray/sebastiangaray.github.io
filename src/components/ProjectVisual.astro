---
interface Props {
  label: string;
  legend: string[];
  variant?: "forecast" | "recommendation" | "sketch";
}

const { label, legend, variant = "forecast" } = Astro.props;
---

<figure class="project-visual">
  <figcaption>{label}</figcaption>
  <svg viewBox="0 0 800 470" role="img" aria-label={label}>
    <defs>
      <pattern id="grid" width="80" height="58" patternUnits="userSpaceOnUse">
        <path d="M80 0H0V58" fill="none" stroke="currentColor" opacity=".12"
        ></path>
      </pattern>
      <linearGradient id="forecast-area" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="var(--accent)" stop-opacity=".24"></stop>
        <stop offset="1" stop-color="var(--accent)" stop-opacity="0"></stop>
      </linearGradient>
    </defs>
    <rect width="800" height="470" fill="var(--background-secondary)"></rect>
    <rect x="42" y="52" width="716" height="340" fill="url(#grid)"></rect>
    {
      variant === "forecast" ? (
        <>
          <path
            d="M42 332C88 319 108 258 151 276s64 63 111 41 53-100 101-82 65 89 111 57 53-141 110-121 72 80 174 7V392H42Z"
            fill="url(#forecast-area)"
          />
          <path
            d="M42 332C88 319 108 258 151 276s64 63 111 41 53-100 101-82 65 89 111 57"
            fill="none"
            stroke="var(--text-primary)"
            stroke-width="4"
          />
          <path
            d="M474 292c45-32 53-141 110-121s72 80 174 7"
            fill="none"
            stroke="var(--accent)"
            stroke-width="4"
            stroke-dasharray="10 8"
          />
          <path
            d="M474 62V392"
            stroke="var(--border-strong)"
            stroke-dasharray="5 7"
          />
          <g fill="var(--text-primary)">
            <>
              <circle cx="151" cy="276" r="6" />
              <circle cx="363" cy="235" r="6" />
              <circle cx="474" cy="292" r="6" />
            </>
          </g>
          <g fill="var(--accent)">
            <>
              <circle cx="584" cy="171" r="6" />
              <circle cx="758" cy="178" r="6" />
            </>
          </g>
        </>
      ) : variant === "recommendation" ? (
        <g>
          {[
            { x: 118, height: 158 },
            { x: 318, height: 236 },
            { x: 518, height: 196 },
          ].map((bar, index) => (
            <g>
              <rect
                x={bar.x}
                y={392 - bar.height}
                width="116"
                height={bar.height}
                fill={index === 1 ? "var(--accent)" : "var(--text-primary)"}
                opacity={index === 2 ? ".62" : "1"}
              />
              <text
                x={bar.x + 58}
                y="425"
                text-anchor="middle"
                fill="var(--text-muted)"
                font-family="JetBrains Mono, monospace"
                font-size="12"
              >
                {String(index + 1).padStart(2, "0")}
              </text>
            </g>
          ))}
        </g>
      ) : (
        <g>
          <rect
            x="86"
            y="92"
            width="260"
            height="260"
            fill="var(--surface)"
            stroke="var(--border-strong)"
            stroke-width="3"
          />
          <path
            d="M151 260c-12-61 24-115 69-119 48-4 91 45 76 110-10 45-41 72-79 71-31-1-58-23-66-62Z"
            fill="none"
            stroke="var(--text-primary)"
            stroke-width="9"
            stroke-linecap="round"
          />
          <path
            d="m161 177 25-41 24 34m49 0 25-34 11 48M184 227h1m69 0h1m-52 39c17 15 35 15 52 0"
            fill="none"
            stroke="var(--text-primary)"
            stroke-width="8"
            stroke-linecap="round"
            stroke-linejoin="round"
          />
          <rect
            x="389"
            y="150"
            width="112"
            height="112"
            fill="var(--surface)"
            stroke="var(--border-strong)"
            stroke-width="3"
          />
          <path
            d="M413 231h14v-47h15v-12h18v13h17v46h-14v9h-36v-9h-14Z"
            fill="var(--text-primary)"
            opacity=".82"
          />
          {[
            { y: 154, width: 164 },
            { y: 213, width: 126 },
            { y: 272, width: 82 },
          ].map((bar, index) => (
            <g>
              <text
                x="545"
                y={bar.y + 17}
                fill="var(--text-muted)"
                font-family="JetBrains Mono, monospace"
                font-size="13"
              >
                {String(index + 1).padStart(2, "0")}
              </text>
              <rect
                x="580"
                y={bar.y}
                width={bar.width}
                height="22"
                fill={index === 0 ? "var(--accent)" : "var(--text-primary)"}
                opacity={index === 2 ? ".5" : ".82"}
              />
            </g>
          ))}
        </g>
      )
    }
    {
      variant === "forecast" && (
        <g
          fill="var(--text-muted)"
          font-family="JetBrains Mono, monospace"
          font-size="12"
        >
          <text x="42" y="425">
            T−04
          </text>
          <text x="212" y="425">
            T−03
          </text>
          <text x="382" y="425">
            T−02
          </text>
          <text x="552" y="425">
            T−01
          </text>
          <text x="724" y="425">
            T
          </text>
        </g>
      )
    }
  </svg>
  <div class="visual-legend">
    {legend.map((item, index) => <span class={`legend-${index}`}>{item}</span>)}
  </div>
</figure>
