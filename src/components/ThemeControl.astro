---
import type { PortfolioContent } from "../content/types";

interface Props {
  content: PortfolioContent;
}

const { content } = Astro.props;
const options = [
  {
    value: "system",
    label: content.theme.system,
    path: "M4 5h16v11H4zM9 20h6m-3-4v4",
  },
  {
    value: "light",
    label: content.theme.light,
    path: "M12 3v2m0 14v2m9-9h-2M5 12H3m15.4-6.4L17 7M7 17l-1.4 1.4m12.8 0L17 17M7 7 5.6 5.6M16 12a4 4 0 1 1-8 0 4 4 0 0 1 8 0Z",
  },
  {
    value: "dark",
    label: content.theme.dark,
    path: "M20 15.2A8.5 8.5 0 0 1 8.8 4 8.5 8.5 0 1 0 20 15.2Z",
  },
] as const;
---

<details class="theme-control" data-theme-control>
  <summary aria-label={content.theme.label}>
    <svg viewBox="0 0 24 24" aria-hidden="true">
      <circle cx="12" cy="12" r="8"></circle>
      <path d="M12 4a8 8 0 0 1 0 16Z"></path>
    </svg>
    <span data-theme-current>{content.theme.system}</span>
  </summary>
  <div class="theme-menu" role="group" aria-label={content.theme.label}>
    {
      options.map((option) => (
        <button
          type="button"
          data-theme-option={option.value}
          aria-pressed="false"
        >
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d={option.path} />
          </svg>
          <span>{option.label}</span>
        </button>
      ))
    }
  </div>
</details>

<script>
  const control = document.querySelector<HTMLDetailsElement>(
    "[data-theme-control]",
  );
  const current = control?.querySelector<HTMLElement>("[data-theme-current]");
  const options = control?.querySelectorAll<HTMLButtonElement>(
    "[data-theme-option]",
  );

  const update = (preference: string) => {
    options?.forEach((option) => {
      const selected = option.dataset.themeOption === preference;
      option.setAttribute("aria-pressed", String(selected));
      if (selected && current)
        current.textContent = option.textContent?.trim() ?? "";
    });
  };

  options?.forEach((option) => {
    option.addEventListener("click", () => {
      window.dispatchEvent(
        new CustomEvent("portfolio-theme-select", {
          detail: option.dataset.themeOption,
        }),
      );
      control?.removeAttribute("open");
    });
  });

  window.addEventListener("portfolio-theme-applied", (event) => {
    if (event instanceof CustomEvent) update(event.detail.preference);
  });

  update(document.documentElement.dataset.themePreference ?? "system");
</script>
