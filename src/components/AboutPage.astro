---
import type { Messages } from "../i18n";
import BaseLayout from "../layouts/BaseLayout.astro";

interface Props {
  messages: Messages;
  alternateHref: string;
}

const { messages, alternateHref } = Astro.props;
---

<BaseLayout
  lang={messages.lang}
  messages={messages}
  title={messages.about.title}
  description={messages.about.description}
  alternateHref={alternateHref}
  translationKey="about"
>
  <header class="page-header">
    <h1>{messages.about.title}</h1>
    <p>{messages.about.description}</p>
  </header>
  <div class="about-grid">
    <section class="about-copy" aria-label={messages.about.title}>
      {messages.about.body.map((paragraph) => <p>{paragraph}</p>)}
    </section>
    <aside class="about-aside">
      <p class="section-label">{messages.about.focus}</p>
      <p>{messages.about.focusBody}</p>
      <a class="button" href="mailto:sebastiangaray@gmail.com"
        >{messages.about.contact}</a
      >
    </aside>
  </div>
</BaseLayout>
