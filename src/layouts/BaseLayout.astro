---
import type { PortfolioContent } from "../content/types";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import themeInit from "../scripts/theme-init.js?raw";
import "../styles/global.css";
import { getAbsoluteLocaleUrl } from "astro:i18n";
import { getLocaleConfig } from "../i18n/config";

interface Props {
  content: PortfolioContent;
}

const { content } = Astro.props;
const locale = getLocaleConfig(content.lang);
const canonical = getAbsoluteLocaleUrl(content.lang);
const alternate = getAbsoluteLocaleUrl(locale.alternate);
const image = new URL("/social-card.svg", Astro.site);
---

<!doctype html>
<html lang={content.lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={content.meta.description} />
    <meta name="theme-color" content="#fdf8f8" />
    <script is:inline set:html={themeInit} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang={content.lang} href={canonical} />
    <link rel="alternate" hreflang={locale.alternate} href={alternate} />
    <link
      rel="alternate"
      hreflang="x-default"
      href={getAbsoluteLocaleUrl("en")}
    />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={content.meta.title} />
    <meta property="og:description" content={content.meta.description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} />
    <meta property="og:locale" content={locale.ogLocale} />
    <meta
      property="og:locale:alternate"
      content={getLocaleConfig(locale.alternate).ogLocale}
    />
    <meta name="twitter:card" content="summary_large_image" />
    <title>{content.meta.title}</title>
  </head>
  <body>
    <a class="skip-link" href="#content">{content.skip}</a>
    <Header content={content} />
    <main id="content">
      <slot />
    </main>
    <Footer content={content} />
  </body>
</html>
