---
import type { PortfolioContent } from "../content/types";
import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectVisual from "./ProjectVisual.astro";

interface Props {
  content: PortfolioContent;
}

const { content } = Astro.props;
---

<BaseLayout content={content}>
  <div class="blueprint-transition" aria-hidden="true" data-transition>
    <div class="blueprint-grid"></div>
    <svg data-blueprint-svg></svg>
  </div>

  <div class="page-view" id="home" data-view="home" tabindex="-1">
    <section class="hero section-shell" aria-labelledby="hero-title">
      <div class="hero-copy" data-assembly>
        <p class="eyebrow">{content.hero.eyebrow}</p>
        <h1 id="hero-title">{content.hero.title}</h1>
        <p class="hero-description">{content.hero.description}</p>
        <div class="actions">
          <a class="button primary" href="#projects" data-view-link>
            {content.hero.projectAction}
          </a>
          <a
            class="button secondary"
            href="https://github.com/SebastianGaray"
            rel="me"
          >
            {content.labels.github}
          </a>
        </div>
      </div>
      <aside class="hero-index" aria-label={content.hero.eyebrow} data-assembly>
        <img
          src="/profile.png"
          alt="Sebastian Garay"
          width="1536"
          height="1024"
        />
      </aside>
    </section>

    <section class="focus section-block" aria-labelledby="focus-title">
      <div class="section-shell">
        <header class="section-header" data-assembly>
          <p class="eyebrow">{content.focus.eyebrow}</p>
          <h2 id="focus-title">{content.focus.title}</h2>
        </header>
        <div class="focus-grid" data-assembly>
          {
            content.focus.areas.map((area, index) => (
              <article>
                <span class="area-number">
                  {String(index + 1).padStart(2, "0")}
                </span>
                <h3>{area.title}</h3>
                <p>{area.description}</p>
                <small>{area.technologies}</small>
              </article>
            ))
          }
        </div>
      </div>
    </section>
  </div>

  <div
    class="page-view"
    id="projects"
    data-view="projects"
    tabindex="-1"
    hidden
  >
    <section
      class="project view-section"
      aria-labelledby="project-title"
      data-assembly
    >
      <div class="section-shell">
        <header class="section-header">
          <p class="eyebrow">{content.project.eyebrow}</p>
          <h1 id="project-title">{content.project.title}</h1>
          <div class="technology-list">
            <span>{content.project.technologyLabel}</span>
            <p>{content.project.technologies.join(" · ")}</p>
          </div>
        </header>

        <div class="project-layout">
          <div data-assembly>
            <ProjectVisual
              label={content.project.visualLabel}
              legend={content.project.visualLegend}
            />
          </div>
          <div class="project-copy" data-assembly>
            <span class="chip">{content.project.synthetic}</span>
            <p class="project-description">{content.project.description}</p>

            <div class="project-links">
              <a href="https://retail-demand-intelligence.streamlit.app/">
                {content.project.links.demo}<span aria-hidden="true"> ↗</span>
              </a>
              <a
                href="https://github.com/SebastianGaray/retail-demand-intelligence"
              >
                {content.project.links.repository}<span aria-hidden="true">
                  ↗</span
                >
              </a>
              <a
                href="https://github.com/SebastianGaray/retail-demand-intelligence/releases/tag/v0.1.0"
              >
                {content.project.links.release}<span aria-hidden="true">
                  ↗</span
                >
              </a>
            </div>

            <div class="project-highlights">
              <h2>{content.project.highlightsTitle}</h2>
              <ol class="highlight-list">
                {
                  content.project.highlights.map((highlight) => (
                    <li>
                      <strong>{highlight.title}</strong>
                      <span>{highlight.description}</span>
                    </li>
                  ))
                }
              </ol>
            </div>
          </div>
        </div>
      </div>
    </section>
  </div>

  <div class="page-view" id="about" data-view="about" tabindex="-1" hidden>
    <section class="background view-section" aria-labelledby="background-title">
      <div class="section-shell two-column">
        <header class="section-header" data-assembly>
          <p class="eyebrow">{content.background.eyebrow}</p>
          <h1 id="background-title">{content.background.title}</h1>
        </header>
        <div class="background-copy" data-assembly>
          <p class="large-copy">{content.background.intro}</p>
          <ul class="evidence-list">
            {
              content.background.highlights.map((highlight) => (
                <li>{highlight}</li>
              ))
            }
          </ul>
        </div>
      </div>
    </section>

    <section
      class="leadership section-block"
      aria-labelledby="leadership-title"
    >
      <div class="section-shell two-column">
        <header class="section-header" data-assembly>
          <p class="eyebrow">{content.leadership.eyebrow}</p>
          <h2 id="leadership-title">{content.leadership.title}</h2>
        </header>
        <div data-assembly>
          <p class="large-copy">{content.leadership.description}</p>
          <ul class="plain-list">
            {content.leadership.points.map((point) => <li>{point}</li>)}
          </ul>
        </div>
      </div>
    </section>

    <section
      class="credentials section-block"
      aria-label={content.credentials.educationTitle}
    >
      <div class="section-shell credentials-grid" data-assembly>
        <article>
          <h2>{content.credentials.educationTitle}</h2>
          <ul>
            {content.credentials.education.map((item) => <li>{item}</li>)}
          </ul>
        </article>
        <article>
          <h2>{content.credentials.publicationTitle}</h2>
          <p>{content.credentials.publication}</p>
        </article>
        <article>
          <h2>{content.credentials.recognitionTitle}</h2>
          <p>{content.credentials.recognition}</p>
        </article>
      </div>
    </section>
  </div>

  <div class="page-view" id="contact" data-view="contact" tabindex="-1" hidden>
    <section
      class="contact view-section section-shell"
      aria-labelledby="contact-title"
      data-assembly
    >
      <div class="contact-intro">
        <p class="eyebrow">{content.contact.eyebrow}</p>
        <h1 id="contact-title">{content.contact.title}</h1>
        <p>{content.contact.description}</p>
      </div>
      <a class="email-link" href="mailto:sebastiangarayperez2@gmail.com">
        sebastiangarayperez2@gmail.com
      </a>
      <nav aria-label={content.contact.eyebrow}>
        <a href="https://github.com/SebastianGaray" rel="me">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path
              d="M12 2a10 10 0 0 0-3.2 19.5c.5.1.7-.2.7-.5v-1.9c-2.8.6-3.4-1.2-3.4-1.2-.5-1.2-1.1-1.5-1.1-1.5-.9-.6.1-.6.1-.6 1 0 1.6 1.1 1.6 1.1.9 1.6 2.4 1.1 2.9.9.1-.7.4-1.1.7-1.4-2.3-.3-4.6-1.1-4.6-5A3.9 3.9 0 0 1 6.7 8.7c-.1-.3-.4-1.3.1-2.7 0 0 .9-.3 2.8 1.1a9.7 9.7 0 0 1 5.1 0C16.6 5.7 17.5 6 17.5 6c.5 1.4.2 2.4.1 2.7a3.9 3.9 0 0 1 1.1 2.7c0 3.9-2.4 4.7-4.6 5 .4.3.7.9.7 1.8V21c0 .3.2.6.7.5A10 10 0 0 0 12 2Z"
            ></path>
          </svg>
          {content.labels.github}
        </a>
        <a
          href="https://www.linkedin.com/in/sebastián-garay-b28610195/"
          rel="me"
        >
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path
              d="M6.5 8.5H3.2V19h3.3V8.5ZM4.9 3A1.9 1.9 0 1 0 5 6.8 1.9 1.9 0 0 0 5 3ZM20.8 13c0-3.2-1.7-4.8-4-4.8a3.5 3.5 0 0 0-3.2 1.8V8.5h-3.3V19h3.3v-5.2c0-1.4.3-2.7 2-2.7 1.6 0 1.7 1.5 1.7 2.8V19h3.3l.2-6Z"
            ></path>
          </svg>
          {content.labels.linkedin}
        </a>
      </nav>
    </section>
  </div>

  <script>
    const views = new Map(
      [...document.querySelectorAll<HTMLElement>("[data-view]")].map((view) => [
        view.dataset.view,
        view,
      ]),
    );
    const overlay = document.querySelector<HTMLElement>("[data-transition]");
    const blueprint = document.querySelector<SVGElement>(
      "[data-blueprint-svg]",
    );
    const reduceMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)",
    ).matches;
    let currentView = "home";
    let transitioning = false;

    const setActiveNavigation = (viewName: string) => {
      document
        .querySelectorAll<HTMLAnchorElement>("[data-view-link]")
        .forEach((link) => {
          const active = link.hash === `#${viewName}`;
          link.classList.toggle("active", active);
          active
            ? link.setAttribute("aria-current", "page")
            : link.removeAttribute("aria-current");
        });
    };

    const drawTarget = (target: HTMLElement) => {
      if (!blueprint) return;
      const wasHidden = target.hidden;
      target.hidden = false;
      target.classList.add("view-measuring");
      const elements = target.querySelectorAll<HTMLElement>(
        "[data-assembly], [data-assembly] :is(h1, h2, h3, p, li, a, figure, svg, article, ol, ul, .chip, .technology-list, .project-links)",
      );
      const width = window.innerWidth;
      const height = window.innerHeight;
      blueprint.setAttribute("viewBox", `0 0 ${width} ${height}`);
      blueprint.replaceChildren(
        ...[...elements]
          .map((element) => element.getBoundingClientRect())
          .filter(
            (rect) =>
              rect.width > 4 &&
              rect.height > 4 &&
              rect.bottom > 0 &&
              rect.top < height,
          )
          .map((rect, index) => {
            const path = document.createElementNS(
              "http://www.w3.org/2000/svg",
              "path",
            );
            const left = Math.max(1, rect.left);
            const right = Math.min(width - 1, rect.right);
            const top = Math.max(1, rect.top);
            const bottom = Math.min(height - 1, rect.bottom);
            path.setAttribute(
              "d",
              [
                `M${left},${top}H${right}V${bottom}H${left}Z`,
                `M${left - 5},${top}H${left + 5}M${left},${top - 5}V${top + 5}`,
                `M${right - 5},${bottom}H${right + 5}M${right},${bottom - 5}V${bottom + 5}`,
              ].join(""),
            );
            path.style.animationDelay = `${Math.min(index * 18, 260)}ms`;
            return path;
          }),
      );
      target.classList.remove("view-measuring");
      target.hidden = wasHidden;
    };

    const showView = async (
      viewName: string,
      updateHistory = true,
      animate = true,
    ) => {
      const target = views.get(viewName);
      if (!target || transitioning || viewName === currentView) return;
      transitioning = true;

      if (animate && !reduceMotion && overlay) {
        drawTarget(target);
        document.body.classList.add("is-transitioning");
        overlay.classList.add("active");
        await new Promise((resolve) => window.setTimeout(resolve, 820));
      }

      views.forEach((view, name) => {
        view.hidden = name !== viewName;
      });
      currentView = viewName;
      setActiveNavigation(viewName);
      window.scrollTo(0, 0);
      if (updateHistory) history.pushState({ viewName }, "", `#${viewName}`);

      if (overlay) {
        overlay.classList.add("leaving");
        await new Promise((resolve) => window.setTimeout(resolve, 220));
        overlay.classList.remove("active", "leaving");
      }
      document.body.classList.remove("is-transitioning");
      target.focus({ preventScroll: true });
      transitioning = false;
    };

    document
      .querySelectorAll<HTMLAnchorElement>("[data-view-link]")
      .forEach((link) => {
        link.addEventListener("click", (event) => {
          event.preventDefault();
          void showView(link.hash.slice(1));
          link.closest("details")?.removeAttribute("open");
        });
      });

    window.addEventListener("popstate", () => {
      void showView(window.location.hash.slice(1) || "home", false);
    });

    const initialView = window.location.hash.slice(1);
    if (initialView && views.has(initialView)) {
      views.forEach((view, name) => {
        view.hidden = name !== initialView;
      });
      currentView = initialView;
    }
    setActiveNavigation(currentView);
  </script>
</BaseLayout>
